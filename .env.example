# Copy to .env and fill in. .env is gitignored — never commit real values.

DB_NAME=lundinassets
DB_USER=lundin_user
# Generate with: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Used only to seed the very first admin account. Changing it later does not
# update an admin that already exists.
ADMIN_EMAIL=admin@lundinassets.se
ADMIN_PASSWORD=
