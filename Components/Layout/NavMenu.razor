@inject NavigationManager Nav

<nav class="navbar navbar-expand-lg navbar-dark sticky-top" style="background-color: #1a2942;">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <i class="bi bi-key-fill text-warning"></i>
            <span class="fw-bold">Lundin Assets</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/assets" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-grid"></i> Assets
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/calendar" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-calendar3"></i> Calendar
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/timeline" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-bar-chart-steps"></i> Timeline
                    </NavLink>
                </li>
                <AuthorizeView>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/bookings" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-journal-bookmark"></i> My Bookings
                        </NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Roles="Admin">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-gear"></i> Admin
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                            <li><a class="dropdown-item" href="/admin/assets"><i class="bi bi-buildings me-2"></i>Manage Assets</a></li>
                            <li><a class="dropdown-item" href="/admin/bookings"><i class="bi bi-calendar-check me-2"></i>Manage Bookings</a></li>
                            <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i>Manage Users</a></li>
                        </ul>
                    </li>
                </AuthorizeView>
            </ul>

            <ul class="navbar-nav ms-auto">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                               role="button" data-bs-toggle="dropdown">
                                @if (!string.IsNullOrEmpty(context.User.FindFirst("ProfilePhoto")?.Value))
                                {
                                    <img src="@context.User.FindFirst("ProfilePhoto")!.Value"
                                         class="rounded-circle" width="28" height="28" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="avatar-initials">
                                        @(context.User.FindFirst("Initials")?.Value ?? "?")
                                    </span>
                                }
                                <span>@context.User.FindFirst("FullName")?.Value</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/account/logout-action">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <a class="nav-link" href="/account/login"><i class="bi bi-box-arrow-in-right me-1"></i>Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/account/register"><i class="bi bi-person-plus me-1"></i>Register</a>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>
