@inject NavigationManager Nav

<!-- Brand -->
<div class="sidebar-brand">
    <div class="sidebar-brand-icon">
        <i class="bi bi-key-fill"></i>
    </div>
    <div>
        <div class="sidebar-brand-text">Lundin Assets</div>
        <div class="sidebar-brand-sub">Family Booking</div>
    </div>
</div>

<!-- Navigation -->
<ul class="sidebar-nav">
    <li>
        <NavLink href="/" Match="NavLinkMatch.All" @onclick="NavClicked">
            <i class="bi bi-house nav-icon"></i> Home
        </NavLink>
    </li>
    <li>
        <NavLink href="/assets" Match="NavLinkMatch.Prefix" @onclick="NavClicked">
            <i class="bi bi-buildings nav-icon"></i> Assets
        </NavLink>
    </li>
    <li>
        <NavLink href="/calendar" Match="NavLinkMatch.Prefix" @onclick="NavClicked">
            <i class="bi bi-calendar3 nav-icon"></i> Calendar
        </NavLink>
    </li>
    <li>
        <NavLink href="/timeline" Match="NavLinkMatch.Prefix" @onclick="NavClicked">
            <i class="bi bi-bar-chart-steps nav-icon"></i> Timeline
        </NavLink>
    </li>
    <li>
        <NavLink href="/bookings" Match="NavLinkMatch.Prefix" @onclick="NavClicked">
            <i class="bi bi-journal-bookmark nav-icon"></i> My Bookings
        </NavLink>
    </li>
</ul>

<AuthorizeView Roles="Admin">
    <div class="sidebar-section-label">Admin</div>
    <ul class="sidebar-nav">
        <li>
            <NavLink href="/admin" Match="NavLinkMatch.All" @onclick="NavClicked">
                <i class="bi bi-speedometer2 nav-icon"></i> Dashboard
            </NavLink>
        </li>
        <li>
            <NavLink href="/admin/assets" Match="NavLinkMatch.Prefix" @onclick="NavClicked">
                <i class="bi bi-pencil-square nav-icon"></i> Manage Assets
            </NavLink>
        </li>
        <li>
            <NavLink href="/admin/bookings" Match="NavLinkMatch.Prefix" @onclick="NavClicked">
                <i class="bi bi-calendar-check nav-icon"></i> Bookings
            </NavLink>
        </li>
        <li>
            <NavLink href="/admin/users" Match="NavLinkMatch.Prefix" @onclick="NavClicked">
                <i class="bi bi-people nav-icon"></i> Users
            </NavLink>
        </li>
    </ul>
</AuthorizeView>

<!-- User footer -->
<div class="sidebar-footer">
    <AuthorizeView>
        <Authorized>
            <a href="/profile" class="sidebar-user" @onclick="NavClicked">
                @if (!string.IsNullOrEmpty(context.User.FindFirst("ProfilePhoto")?.Value))
                {
                    <img src="@context.User.FindFirst("ProfilePhoto")!.Value"
                         class="avatar" width="32" height="32" />
                }
                else
                {
                    <span class="avatar avatar-initials" style="width:32px;height:32px;font-size:.72rem;">
                        @(context.User.FindFirst("Initials")?.Value ?? "?")
                    </span>
                }
                <div style="overflow:hidden;">
                    <div class="sidebar-user-name">
                        @context.User.FindFirst("FullName")?.Value
                    </div>
                    <div class="sidebar-user-role">
                        @(context.User.IsInRole("Admin") ? "Administrator" : "Member")
                    </div>
                </div>
            </a>
        </Authorized>
        <NotAuthorized>
            <a href="/account/login" class="sidebar-user">
                <span class="avatar avatar-initials" style="width:32px;height:32px;font-size:.72rem;">?</span>
                <div class="sidebar-user-name">Sign In</div>
            </a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public EventCallback OnNavClick { get; set; }

    async Task NavClicked() => await OnNavClick.InvokeAsync();
}
