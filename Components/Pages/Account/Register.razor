@page "/account/register"
@layout EmptyLayout
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Register - Lundin Assets</PageTitle>

<div class="login-page-wrap">
  <div style="width:100%;max-width:440px;position:relative;z-index:1;">
    <div class="text-center mb-4">
        <div class="login-logo"><i class="bi bi-person-plus-fill"></i></div>
        <h4 class="text-white fw-bold mb-1" style="letter-spacing:-.02em;">Create Account</h4>
        <p class="mb-0" style="color:rgba(255,255,255,.45);font-size:.83rem;">Join the family booking system</p>
    </div>
    <div class="login-card">
        <div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @ErrorMessage
                        </div>
                    }

                    <EditForm Model="Model" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label class="form-label fw-semibold">First Name</label>
                                <InputText @bind-Value="Model.FirstName" class="form-control"
                                           placeholder="First name" />
                                <ValidationMessage For="() => Model.FirstName" class="text-danger small" />
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label fw-semibold">Last Name</label>
                                <InputText @bind-Value="Model.LastName" class="form-control"
                                           placeholder="Last name" />
                                <ValidationMessage For="() => Model.LastName" class="text-danger small" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <InputText @bind-Value="Model.Email" type="email" class="form-control"
                                           placeholder="your@email.com" />
                            </div>
                            <ValidationMessage For="() => Model.Email" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <InputText @bind-Value="Model.Password" type="password" class="form-control"
                                           placeholder="Min. 8 characters" />
                            </div>
                            <ValidationMessage For="() => Model.Password" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <InputText @bind-Value="Model.ConfirmPassword" type="password" class="form-control"
                                           placeholder="Repeat password" />
                            </div>
                            <ValidationMessage For="() => Model.ConfirmPassword" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-semibold" disabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-person-check me-1"></i> Create Account
                        </button>
                    </EditForm>

                    <div class="divider"></div>
                    <p class="text-center mb-0" style="font-size:.82rem;color:var(--muted);">
                        Already have an account?
                        <a href="/account/login" style="font-weight:600;">Sign In</a>
                    </p>
        </div>
    </div>
  </div>
</div>

@* Hidden form submitted via JS after account creation to set the auth cookie
   via a real HTTP response (same mechanism as the login page). *@
@if (AutoLoginEmail != null)
{
    <form id="post-register-login" method="post" action="/account/login-action" style="display:none">
        <input type="hidden" name="Email"     value="@AutoLoginEmail" />
        <input type="hidden" name="Password"  value="@AutoLoginPassword" />
        <input type="hidden" name="ReturnUrl" value="/" />
    </form>
}

@code {
    RegisterModel Model = new();
    string? ErrorMessage;
    bool IsLoading;
    string? AutoLoginEmail;
    string? AutoLoginPassword;

    async Task HandleRegister()
    {
        IsLoading = true;
        ErrorMessage = null;

        if (Model.Password != Model.ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match.";
            IsLoading = false;
            return;
        }

        var user = new ApplicationUser
        {
            UserName = Model.Email,
            Email = Model.Email,
            FirstName = Model.FirstName,
            LastName = Model.LastName,
            EmailConfirmed = true,
            CreatedAt = DateTime.UtcNow
        };

        var result = await UserManager.CreateAsync(user, Model.Password);
        if (!result.Succeeded)
        {
            ErrorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            IsLoading = false;
            return;
        }

        await UserManager.AddToRoleAsync(user, "User");

        // Sign in via a real HTTP form POST so the auth cookie is set on a proper
        // HTTP response — calling SignInManager directly from Blazor Server doesn't
        // deliver the cookie to the browser before NavigateTo fires.
        AutoLoginEmail    = Model.Email;
        AutoLoginPassword = Model.Password;
        StateHasChanged();
        await JS.InvokeVoidAsync("submitForm", "post-register-login");
    }

    class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string FirstName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string LastName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(8)]
        public string Password { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmPassword { get; set; } = "";
    }
}
