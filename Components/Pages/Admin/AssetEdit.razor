@page "/admin/assets/edit"
@page "/admin/assets/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject AssetService AssetService
@inject FileUploadService FileUpload
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New Asset" : "Edit Asset") - Lundin Assets</PageTitle>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
            <li class="breadcrumb-item"><a href="/admin/assets">Assets</a></li>
            <li class="breadcrumb-item active">@(IsNew ? "New Asset" : CurrentAsset?.Name)</li>
        </ol>
    </nav>

    <h2 class="mb-4 fw-bold">
        <i class="bi @(IsNew ? "bi-plus-circle" : "bi-pencil") me-2"></i>
        @(IsNew ? "New Asset" : "Edit Asset")
    </h2>

    @if (CurrentAsset == null && !IsNew)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h5 class="mb-3">Basic Details</h5>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger">@ErrorMessage</div>
                        }

                        <EditForm Model="Form" OnValidSubmit="HandleSave">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Name *</label>
                                <InputText @bind-Value="Form.Name" class="form-control" placeholder="Asset name" />
                                <ValidationMessage For="() => Form.Name" class="text-danger small" />
                            </div>

                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <label class="form-label fw-semibold">Type *</label>
                                    <InputSelect @bind-Value="Form.Type" class="form-select">
                                        <option value="@AssetType.Housing">Housing</option>
                                        <option value="@AssetType.Car">Car</option>
                                        <option value="@AssetType.Other">Other</option>
                                    </InputSelect>
                                </div>
                                <div class="col-sm-6 mb-3">
                                    <label class="form-label fw-semibold">Color</label>
                                    <div class="d-flex gap-2 flex-wrap mt-1">
                                        @foreach (var color in ColorPalette)
                                        {
                                            <button type="button"
                                                    class="color-swatch @(Form.Color == color ? "selected" : "")"
                                                    style="background-color: @color;"
                                                    @onclick="() => Form.Color = color"></button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <label class="form-label fw-semibold">Location</label>
                                    <InputText @bind-Value="Form.Location" class="form-control"
                                               placeholder="e.g. Fjällbacka, Sweden" />
                                </div>
                                <div class="col-sm-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        Number of Beds
                                        <span class="text-muted fw-normal">(housing only)</span>
                                    </label>
                                    <InputNumber @bind-Value="Form.BedCount" class="form-control"
                                                 placeholder="e.g. 4" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Description</label>
                                <InputTextArea @bind-Value="Form.Description" class="form-control" rows="3"
                                               placeholder="Describe the asset..." />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Instructions</label>
                                <InputTextArea @bind-Value="Form.Instructions" class="form-control" rows="5"
                                               placeholder="Access codes, rules, check-in/out info..." />
                            </div>

                            <div class="mb-4">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="Form.IsAvailable" class="form-check-input" id="isAvailable" />
                                    <label class="form-check-label fw-semibold" for="isAvailable">
                                        Available for booking
                                    </label>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@IsSaving">
                                    @if (IsSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                    <i class="bi bi-check-lg me-1"></i>@(IsNew ? "Create Asset" : "Save Changes")
                                </button>
                                <a href="/admin/assets" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </EditForm>
                    </div>
                </div>

                @if (!IsNew && CurrentAsset != null)
                {
                    <!-- Photos Section -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h5 class="mb-3"><i class="bi bi-images me-2 text-primary"></i>Photos</h5>

                            @if (!string.IsNullOrEmpty(PhotoMessage))
                            {
                                <div class="alert alert-success py-2 mb-3">@PhotoMessage</div>
                            }

                            @if (CurrentAsset.Photos.Any())
                            {
                                <div class="row g-2 mb-3">
                                    @foreach (var photo in CurrentAsset.Photos.OrderBy(p => p.SortOrder))
                                    {
                                        <div class="col-6 col-md-4 col-lg-3">
                                            <div class="photo-manage-card @(photo.IsMain ? "is-main" : "")">
                                                <img src="@photo.FilePath" class="photo-manage-img" alt="" />
                                                @if (photo.IsMain)
                                                {
                                                    <span class="photo-main-badge">Main</span>
                                                }
                                                <div class="photo-manage-actions">
                                                    @if (!photo.IsMain)
                                                    {
                                                        <button class="btn btn-sm btn-light"
                                                                @onclick="() => SetMainPhoto(photo.Id)"
                                                                title="Set as main">
                                                            <i class="bi bi-star"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-danger"
                                                            @onclick="() => DeletePhoto(photo)"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div>
                                <label class="form-label fw-semibold">Upload Photos</label>
                                <InputFile OnChange="HandlePhotoUpload" accept="image/*" multiple class="form-control" />
                                <small class="text-muted">JPG, PNG or WebP, max 10MB each</small>
                            </div>
                        </div>
                    </div>

                    <!-- Unavailability Periods -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="mb-3"><i class="bi bi-calendar-x me-2 text-primary"></i>Blocked Dates</h5>
                            <p class="text-muted small">Mark date ranges when this asset is unavailable for booking (maintenance, private use, etc.)</p>

                            @if (CurrentAsset.UnavailabilityPeriods.Any())
                            {
                                <div class="d-flex flex-column gap-2 mb-3">
                                    @foreach (var p in CurrentAsset.UnavailabilityPeriods.OrderBy(u => u.StartDate))
                                    {
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded border bg-light">
                                            <div>
                                                <span class="fw-semibold small">
                                                    @p.StartDate.ToString("MMM d, yyyy") – @p.EndDate.ToString("MMM d, yyyy")
                                                </span>
                                                @if (!string.IsNullOrEmpty(p.Reason))
                                                {
                                                    <span class="text-muted small ms-2">(@p.Reason)</span>
                                                }
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => DeleteUnavailability(p.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="card bg-light border-0 p-3">
                                <div class="row g-2">
                                    <div class="col-sm-4">
                                        <label class="form-label small fw-semibold">From</label>
                                        <input type="date" class="form-control form-control-sm"
                                               @bind="NewBlockStart" />
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label small fw-semibold">To</label>
                                        <input type="date" class="form-control form-control-sm"
                                               @bind="NewBlockEnd" />
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="form-label small fw-semibold">Reason (optional)</label>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="NewBlockReason" placeholder="e.g. Maintenance" />
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-primary mt-2" @onclick="AddUnavailability">
                                    <i class="bi bi-plus me-1"></i>Add Blocked Period
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Preview sidebar -->
            @if (!IsNew && CurrentAsset != null)
            {
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm sticky-top" style="top: 80px;">
                        <div class="card-header" style="background-color: @Form.Color;">
                            <h6 class="mb-0 text-white fw-semibold">Preview</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="asset-card-placeholder mb-3"
                                 style="height: 120px; color: @Form.Color; background-color: @(Form.Color + "22");">
                                <i class="bi @CurrentAsset.TypeIcon" style="font-size: 2.5rem;"></i>
                            </div>
                            <h5 class="fw-bold mb-1">@(string.IsNullOrEmpty(Form.Name) ? "Asset Name" : Form.Name)</h5>
                            @if (!string.IsNullOrEmpty(Form.Location))
                            {
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>@Form.Location
                                </p>
                            }
                            @if (Form.BedCount.HasValue)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-moon me-1"></i>@Form.BedCount beds
                                </span>
                            }
                            <div class="mt-2">
                                @if (Form.IsAvailable)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Unavailable</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    Asset? CurrentAsset;
    AssetEditForm Form = new();
    bool IsSaving;
    bool IsNew => Id == null;
    string? ErrorMessage, PhotoMessage;

    DateTime NewBlockStart = DateTime.Today;
    DateTime NewBlockEnd = DateTime.Today.AddDays(7);
    string? NewBlockReason;

    static readonly string[] ColorPalette =
    {
        "#3b82f6", "#ef4444", "#10b981", "#f59e0b",
        "#8b5cf6", "#ec4899", "#14b8a6", "#f97316",
        "#6366f1", "#84cc16"
    };

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            Form = new AssetEditForm { Color = ColorPalette[0] };
        }
        else
        {
            CurrentAsset = await AssetService.GetByIdAsync(Id!.Value);
            if (CurrentAsset != null)
            {
                Form = new AssetEditForm
                {
                    Name = CurrentAsset.Name,
                    Type = CurrentAsset.Type,
                    Color = CurrentAsset.Color,
                    Location = CurrentAsset.Location,
                    BedCount = CurrentAsset.BedCount,
                    Description = CurrentAsset.Description,
                    Instructions = CurrentAsset.Instructions,
                    IsAvailable = CurrentAsset.IsAvailable
                };
            }
        }
    }

    async Task HandleSave()
    {
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            if (IsNew)
            {
                var asset = new Asset
                {
                    Name = Form.Name,
                    Type = Form.Type,
                    Color = Form.Color,
                    Location = Form.Location,
                    BedCount = Form.BedCount,
                    Description = Form.Description,
                    Instructions = Form.Instructions,
                    IsAvailable = Form.IsAvailable
                };
                var created = await AssetService.CreateAsync(asset);
                Nav.NavigateTo($"/admin/assets/edit/{created.Id}");
            }
            else if (CurrentAsset != null)
            {
                CurrentAsset.Name = Form.Name;
                CurrentAsset.Type = Form.Type;
                CurrentAsset.Color = Form.Color;
                CurrentAsset.Location = Form.Location;
                CurrentAsset.BedCount = Form.BedCount;
                CurrentAsset.Description = Form.Description;
                CurrentAsset.Instructions = Form.Instructions;
                CurrentAsset.IsAvailable = Form.IsAvailable;
                await AssetService.UpdateAsync(CurrentAsset);
                PhotoMessage = "Asset saved.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally { IsSaving = false; }
    }

    async Task HandlePhotoUpload(InputFileChangeEventArgs e)
    {
        PhotoMessage = null;
        foreach (var file in e.GetMultipleFiles(10))
        {
            var path = await FileUpload.SaveAsync(file, "assets");
            if (path != null)
            {
                await AssetService.AddPhotoAsync(new AssetPhoto
                {
                    AssetId = CurrentAsset!.Id,
                    FilePath = path,
                    IsMain = !CurrentAsset.Photos.Any(),
                    SortOrder = CurrentAsset.Photos.Count
                });
            }
        }
        CurrentAsset = await AssetService.GetByIdAsync(CurrentAsset!.Id);
        PhotoMessage = "Photos uploaded.";
    }

    async Task SetMainPhoto(int photoId)
    {
        await AssetService.SetMainPhotoAsync(CurrentAsset!.Id, photoId);
        CurrentAsset = await AssetService.GetByIdAsync(CurrentAsset.Id);
    }

    async Task DeletePhoto(AssetPhoto photo)
    {
        FileUpload.Delete(photo.FilePath);
        await AssetService.DeletePhotoAsync(photo.Id);
        CurrentAsset = await AssetService.GetByIdAsync(CurrentAsset!.Id);
    }

    async Task AddUnavailability()
    {
        if (NewBlockEnd < NewBlockStart) return;
        await AssetService.AddUnavailabilityAsync(new UnavailabilityPeriod
        {
            AssetId = CurrentAsset!.Id,
            StartDate = DateOnly.FromDateTime(NewBlockStart),
            EndDate = DateOnly.FromDateTime(NewBlockEnd),
            Reason = NewBlockReason
        });
        CurrentAsset = await AssetService.GetByIdAsync(CurrentAsset.Id);
        NewBlockReason = null;
    }

    async Task DeleteUnavailability(int id)
    {
        await AssetService.DeleteUnavailabilityAsync(id);
        CurrentAsset = await AssetService.GetByIdAsync(CurrentAsset!.Id);
    }

    class AssetEditForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = "";
        public AssetType Type { get; set; } = AssetType.Housing;
        public string Color { get; set; } = "#3b82f6";
        public string? Location { get; set; }
        public int? BedCount { get; set; }
        public string? Description { get; set; }
        public string? Instructions { get; set; }
        public bool IsAvailable { get; set; } = true;
    }
}
