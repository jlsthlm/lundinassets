@page "/admin/assets"
@attribute [Authorize(Roles = "Admin")]
@inject AssetService AssetService
@inject FileUploadService FileUpload

<PageTitle>Manage Assets - Lundin Assets</PageTitle>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0 fw-bold"><i class="bi bi-buildings me-2"></i>Manage Assets</h2>
        <a href="/admin/assets/edit" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i>New Asset
        </a>
    </div>

    @if (AllAssets == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (!AllAssets.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
            <p class="mt-2">No assets yet.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Asset</th>
                            <th class="d-none d-md-table-cell">Type</th>
                            <th class="d-none d-lg-table-cell">Location</th>
                            <th class="d-none d-md-table-cell">Beds</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in AllAssets)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (asset.PrimaryPhoto != null)
                                        {
                                            <img src="@asset.PrimaryPhoto.FilePath"
                                                 class="rounded" width="40" height="40"
                                                 style="object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded d-flex align-items-center justify-content-center"
                                                 style="width:40px;height:40px;background-color:@(asset.Color + "22");color:@asset.Color;">
                                                <i class="bi @asset.TypeIcon"></i>
                                            </div>
                                        }
                                        <span class="fw-semibold">@asset.Name</span>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    <span class="badge" style="background-color: @asset.Color;">
                                        <i class="bi @asset.TypeIcon me-1"></i>@asset.TypeLabel
                                    </span>
                                </td>
                                <td class="d-none d-lg-table-cell text-muted small">@asset.Location</td>
                                <td class="d-none d-md-table-cell text-muted">
                                    @(asset.BedCount.HasValue ? $"{asset.BedCount}" : "–")
                                </td>
                                <td>
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@asset.IsAvailable"
                                               @onchange="() => ToggleAvailability(asset)" />
                                        <label class="form-check-label small @(asset.IsAvailable ? "text-success" : "text-danger")">
                                            @(asset.IsAvailable ? "Available" : "Off")
                                        </label>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/assets/@asset.Id" class="btn btn-outline-secondary" target="_blank"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/admin/assets/edit/@asset.Id" class="btn btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-outline-danger"
                                                @onclick="() => ConfirmDelete(asset)"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (DeletingAsset != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>Delete Asset
                        </h5>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong>@DeletingAsset.Name</strong>?</p>
                        <p class="text-danger small">This will also delete all photos and unavailability periods. Existing bookings must be cancelled first.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="() => DeletingAsset = null">Cancel</button>
                        <button class="btn btn-danger" @onclick="DoDelete">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast show align-items-center text-bg-success border-0">
                <div class="d-flex">
                    <div class="toast-body">@Message</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            @onclick="() => Message = null"></button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    List<Asset>? AllAssets;
    Asset? DeletingAsset;
    string? Message;

    protected override async Task OnInitializedAsync()
    {
        AllAssets = await AssetService.GetAllAsync();
    }

    async Task ToggleAvailability(Asset asset)
    {
        asset.IsAvailable = !asset.IsAvailable;
        await AssetService.UpdateAsync(asset);
        Message = $"{asset.Name} marked as {(asset.IsAvailable ? "available" : "unavailable")}.";
    }

    void ConfirmDelete(Asset asset) => DeletingAsset = asset;

    async Task DoDelete()
    {
        if (DeletingAsset == null) return;
        // Delete photos from disk
        var full = await AssetService.GetByIdAsync(DeletingAsset.Id);
        if (full != null)
            foreach (var p in full.Photos)
                FileUpload.Delete(p.FilePath);

        await AssetService.DeleteAsync(DeletingAsset.Id);
        DeletingAsset = null;
        Message = "Asset deleted.";
        AllAssets = await AssetService.GetAllAsync();
    }
}
