@page "/assets"
@attribute [Authorize]
@inject AssetService AssetService

<PageTitle>Assets - Lundin Assets</PageTitle>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <h2 class="mb-0 fw-bold"><i class="bi bi-buildings me-2"></i>Assets</h2>
        <div class="d-flex gap-2 flex-wrap">
            <div class="btn-group">
                <button class="btn @(FilterType == null ? "btn-primary" : "btn-outline-secondary") btn-sm"
                        @onclick="() => SetFilter(null)">All</button>
                <button class="btn @(FilterType == AssetType.Housing ? "btn-primary" : "btn-outline-secondary") btn-sm"
                        @onclick="() => SetFilter(AssetType.Housing)">
                    <i class="bi bi-house-door me-1"></i>Housing
                </button>
                <button class="btn @(FilterType == AssetType.Car ? "btn-primary" : "btn-outline-secondary") btn-sm"
                        @onclick="() => SetFilter(AssetType.Car)">
                    <i class="bi bi-car-front me-1"></i>Cars
                </button>
                <button class="btn @(FilterType == AssetType.Other ? "btn-primary" : "btn-outline-secondary") btn-sm"
                        @onclick="() => SetFilter(AssetType.Other)">
                    <i class="bi bi-box me-1"></i>Other
                </button>
            </div>
        </div>
    </div>

    @if (AllAssets == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (!Filtered.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
            <p class="mt-2">No assets found.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var asset in Filtered)
            {
                <div class="col">
                    <a href="/assets/@asset.Id" class="text-decoration-none">
                        <div class="card asset-card h-100">
                            <div class="asset-card-photo">
                                @if (asset.PrimaryPhoto != null)
                                {
                                    <img src="@asset.PrimaryPhoto.FilePath" class="asset-card-img" alt="@asset.Name" />
                                }
                                else
                                {
                                    <div class="asset-card-placeholder"
                                         style="color: @asset.Color; background-color: @(asset.Color + "22");">
                                        <i class="bi @asset.TypeIcon"></i>
                                    </div>
                                }
                                <span class="asset-type-badge" style="background-color: @asset.Color;">
                                    <i class="bi @asset.TypeIcon me-1"></i>@asset.TypeLabel
                                </span>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title mb-1">@asset.Name</h5>
                                @if (!string.IsNullOrEmpty(asset.Location))
                                {
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-geo-alt me-1"></i>@asset.Location
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(asset.Description))
                                {
                                    <p class="card-text text-muted small">
                                        @(asset.Description.Length > 100
                                            ? asset.Description[..100] + "…"
                                            : asset.Description)
                                    </p>
                                }
                                <div class="d-flex gap-2 flex-wrap mt-2">
                                    @if (asset.BedCount.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-moon me-1"></i>@asset.BedCount beds
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                                @if (asset.IsAvailable)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-x-circle me-1"></i>Unavailable
                                    </span>
                                }
                                <span class="small text-muted">Book now <i class="bi bi-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    List<Asset>? AllAssets;
    AssetType? FilterType;

    IEnumerable<Asset> Filtered => AllAssets?
        .Where(a => FilterType == null || a.Type == FilterType)
        ?? Enumerable.Empty<Asset>();

    protected override async Task OnInitializedAsync()
    {
        AllAssets = await AssetService.GetAllAsync();
    }

    void SetFilter(AssetType? type) => FilterType = type;
}
