@inject IJSRuntime JS

<div class="card border-0 shadow-sm booking-card @StatusClass">
    <div class="card-body p-3">
        <div class="d-flex align-items-start justify-content-between mb-2">
            <div>
                <div class="fw-semibold">@Booking.Asset.Name</div>
                @if (!string.IsNullOrEmpty(Booking.Asset.Location))
                {
                    <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@Booking.Asset.Location</div>
                }
            </div>
            <span class="badge" style="background-color: @Booking.Asset.Color;">
                <i class="bi @Booking.Asset.TypeIcon"></i>
            </span>
        </div>

        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-calendar text-muted small"></i>
            <span class="small">
                @Booking.StartDate.ToString("MMM d") – @Booking.EndDate.ToString("MMM d, yyyy")
            </span>
            <span class="badge bg-light text-dark border small">@Booking.NightCount nights</span>
            @if (Booking.IsFullBooking)
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                    <i class="bi bi-lock me-1"></i>Exclusive
                </span>
            }
            else if (Booking.BedsBooked.HasValue)
            {
                <span class="badge bg-info-subtle text-info border border-info-subtle small">
                    <i class="bi bi-moon me-1"></i>@Booking.BedsBooked bed@(Booking.BedsBooked == 1 ? "" : "s")
                </span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Booking.Notes))
        {
            <p class="text-muted small mb-2 fst-italic">"@Booking.Notes"</p>
        }

        <div class="d-flex justify-content-between align-items-center mt-2">
            @switch (Booking.Status)
            {
                case BookingStatus.Confirmed:
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Confirmed</span>
                    break;
                case BookingStatus.Pending:
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                    break;
                case BookingStatus.Cancelled:
                    <span class="badge bg-secondary-subtle text-secondary border">Cancelled</span>
                    break;
            }

            @if (Booking.Status != BookingStatus.Cancelled
                && Booking.EndDate > DateOnly.FromDateTime(DateTime.Today))
            {
                <div class="d-flex gap-2">
                    @if (ShowEdit)
                    {
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="() => OnEdit.InvokeAsync(Booking)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                    }
                    @if (ShowCancel)
                    {
                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="ConfirmCancel">
                            <i class="bi bi-x me-1"></i>Cancel
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (ShowConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cancel Booking?</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel your booking for <strong>@Booking.Asset.Name</strong>?</p>
                    <p class="text-muted small">@Booking.StartDate.ToString("MMM d") – @Booking.EndDate.ToString("MMM d, yyyy")</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => ShowConfirm = false">Keep Booking</button>
                    <button class="btn btn-danger" @onclick="DoCancel">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Booking Booking { get; set; } = null!;
    [Parameter] public bool ShowCancel { get; set; } = true;
    [Parameter] public bool ShowEdit { get; set; } = true;
    [Parameter] public EventCallback<int> OnCancel { get; set; }
    [Parameter] public EventCallback<Booking> OnEdit { get; set; }

    bool ShowConfirm;

    string StatusClass => Booking.Status switch
    {
        BookingStatus.Cancelled => "opacity-50",
        _ => ""
    };

    void ConfirmCancel() => ShowConfirm = true;

    async Task DoCancel()
    {
        ShowConfirm = false;
        await OnCancel.InvokeAsync(Booking.Id);
    }
}
