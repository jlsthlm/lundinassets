@page "/timeline"
@attribute [Authorize]
@inject BookingService BookingService
@inject AssetService AssetService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Timeline - Lundin Assets</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <h2 class="mb-0 fw-bold"><i class="bi bi-bar-chart-steps me-2"></i>Booking Timeline</h2>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <div class="btn-group btn-group-sm">
                <button class="btn @(Mode == ViewMode.Day   ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SwitchMode(ViewMode.Day)">Day</button>
                <button class="btn @(Mode == ViewMode.Week  ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SwitchMode(ViewMode.Week)">Week</button>
                <button class="btn @(Mode == ViewMode.Month ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SwitchMode(ViewMode.Month)">Month</button>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="JumpToToday">
                <i class="bi bi-crosshair me-1"></i>Today
            </button>
            <a href="/calendar" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-calendar3 me-1"></i>Calendar
            </a>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (!AllAssets.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size:2rem;"></i>
            <p class="mt-2">No assets found.</p>
        </div>
    }
    else
    {
        <div class="vtl-wrap card border-0 shadow-sm">
            <!-- Sticky column headers -->
            <div class="vtl-header-row" style="grid-template-columns: @GridColumns;">
                <div class="vtl-header-date-cell">
                    <span class="tiny text-muted text-uppercase fw-bold" style="letter-spacing:.05em;">
                        @(Mode == ViewMode.Month ? "Month" : Mode == ViewMode.Week ? "Week" : "Date")
                    </span>
                </div>
                @foreach (var asset in AllAssets)
                {
                    <div class="vtl-header-asset-cell" style="border-top: 3px solid @asset.Color;">
                        <div class="fw-semibold small">@asset.Name</div>
                        @if (!string.IsNullOrEmpty(asset.Location))
                        {
                            <div class="tiny text-muted"><i class="bi bi-geo-alt me-1"></i>@asset.Location</div>
                        }
                        @if (asset.BedCount.HasValue)
                        {
                            <div class="tiny text-muted"><i class="bi bi-moon me-1"></i>@asset.BedCount beds</div>
                        }
                    </div>
                }
            </div>

            <!-- Scrollable body -->
            <div class="vtl-body">
                @{
                    var periods = Periods;
                    var assets  = AllAssets;
                }

                <div class="vtl-rows"
                     style="grid-template-columns: @GridColumns; grid-auto-rows: minmax(@RowHeight, auto);">

                    @if (Mode == ViewMode.Day)
                    {
                        <!-- ── Day view: sequential rows, multi-row blocks via top/mid/bottom caps ── -->
                        @foreach (var day in periods)
                        {
                            bool isToday      = day == Today;
                            bool isWeekend    = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                            bool isMonthStart = day.Day == 1;
                            string state = (isToday ? " vtl-today" : "")
                                         + (isWeekend ? " vtl-weekend" : "")
                                         + (isMonthStart ? " vtl-month-start" : "");

                            <div class="vtl-date-cell@(state)">
                                @if (isMonthStart || day == periods.First())
                                {
                                    <span class="vtl-month-tag">@day.ToString("MMM")</span>
                                }
                                <span class="vtl-day-num @(isToday ? "text-primary fw-bold" : "")">@day.Day</span>
                                <span class="vtl-dow text-muted">@day.ToString("ddd")[..2]</span>
                            </div>

                            @foreach (var asset in assets)
                            {
                                var cell = GetCell(asset.Id, day);
                                <div class="vtl-asset-cell@(state)">
                                    @if (cell != null)
                                    {
                                        <div class="vtl-block vtl-block-@cell.Pos.ToString().ToLower()"
                                             style="--block-color: @cell.Color;" title="@cell.Label">
                                            @if (cell.Pos is CellPos.Top or CellPos.Single)
                                            {
                                                <span class="vtl-block-label">@cell.Label</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <!-- ── Week / Month view ────────────────────────────────────────────────────
                             Pass 1: background cells (date labels + empty asset cells, explicit placement).
                             Pass 2: booking/unavailability spans overlaid with grid-row: start/end.
                             Both passes render into the same grid; z-index controls layering.
                        ── -->

                        <!-- Pass 1 — background -->
                        @for (int i = 0; i < periods.Count; i++)
                        {
                            var period   = periods[i];
                            bool isCurrent  = IsCurrentPeriod(period);
                            bool isFirst    = i == 0;
                            bool isYearStart = period.Month == 1;
                            string state = isCurrent ? " vtl-today" : "";
                            int row = i + 1;

                            <div class="vtl-date-cell vtl-period-label@(state)"
                                 style="grid-column:1; grid-row:@row;">
                                @if (Mode == ViewMode.Week)
                                {
                                    @if (isFirst || period.Month != periods[i - 1].Month)
                                    {
                                        <span class="vtl-month-tag">@period.ToString("MMM")</span>
                                    }
                                    <span class="vtl-day-num @(isCurrent ? "text-primary fw-bold" : "")">@period.Day</span>
                                    <span class="vtl-dow text-muted">@period.ToString("ddd")[..2]</span>
                                }
                                else
                                {
                                    @if (isFirst || isYearStart)
                                    {
                                        <span class="vtl-month-tag">@period.Year</span>
                                    }
                                    <span class="vtl-day-num @(isCurrent ? "text-primary fw-bold" : "")">@period.ToString("MMM")</span>
                                }
                            </div>

                            @for (int j = 0; j < assets.Count; j++)
                            {
                                <div class="vtl-bg-cell@(state)"
                                     style="grid-column:@(j+2); grid-row:@row;"></div>
                            }
                        }

                        <!-- Pass 2 — spanning booking blocks -->
                        @foreach (var b in AllBookings)
                        {
                            int assetIdx = assets.FindIndex(a => a.Id == b.AssetId);
                            if (assetIdx < 0) continue;

                            int startRow = SpanStartRow(b.StartDate, periods);
                            int endRow   = SpanEndRow(b.EndDate.AddDays(-1), periods);
                            if (startRow > periods.Count || endRow < 1) continue;
                            startRow = Math.Max(1, startRow);
                            endRow   = Math.Min(periods.Count + 1, endRow);

                            var label = b.IsFullBooking
                                ? b.User.FullName
                                : $"{b.User.FullName} ({b.BedsBooked} bed{(b.BedsBooked == 1 ? "" : "s")})";
                            var dates = $"{b.StartDate:MMM d} – {b.EndDate.AddDays(-1):MMM d, yyyy}";

                            <div class="vtl-span-block"
                                 style="grid-column:@(assetIdx+2); grid-row:@startRow/@endRow; background-color:@b.Asset.Color;"
                                 title="@label · @dates">
                                <span class="vtl-span-name">@label</span>
                                <span class="vtl-span-dates">@dates</span>
                            </div>
                        }

                        <!-- Pass 2b — unavailability spans -->
                        @foreach (var asset in assets)
                        {
                            int assetIdx = assets.FindIndex(a => a.Id == asset.Id);
                            @foreach (var u in asset.UnavailabilityPeriods)
                            {
                                int startRow = SpanStartRow(u.StartDate, periods);
                                int endRow   = SpanEndRow(u.EndDate, periods);
                                if (startRow > periods.Count || endRow < 1) continue;
                                startRow = Math.Max(1, startRow);
                                endRow   = Math.Min(periods.Count + 1, endRow);

                                <div class="vtl-span-block vtl-span-unavail"
                                     style="grid-column:@(assetIdx+2); grid-row:@startRow/@endRow;"
                                     title="Unavailable">
                                    <span class="vtl-span-name">Unavailable</span>
                                </div>
                            }
                        }
                    }

                </div>

                @if (IsLoadingMore)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                    </div>
                }
                <div id="vtl-sentinel"></div>
            </div>
        </div>

        <!-- Legend -->
        <div class="d-flex flex-wrap gap-3 mt-3 align-items-center">
            <span class="text-muted small">Assets:</span>
            @foreach (var a in AllAssets)
            {
                <span class="d-flex align-items-center gap-2 small">
                    <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:@a.Color;"></span>
                    @a.Name
                </span>
            }
            <span class="d-flex align-items-center gap-2 small text-muted">
                <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#d1d5db;"></span>
                Unavailable
            </span>
        </div>
    }
</div>

@code {
    // ── State ──────────────────────────────────────────────────────────────────

    List<Asset>   AllAssets   = new();
    List<Booking> AllBookings = new();
    bool IsLoading     = true;
    bool IsLoadingMore = false;
    DateOnly Today   = DateOnly.FromDateTime(DateTime.Today);
    DateOnly ViewStart;
    DateOnly ViewEnd;
    DotNetObjectReference<Timeline>? DotNetRef;

    enum ViewMode { Day, Week, Month }
    ViewMode Mode = ViewMode.Day;

    string RowHeight => Mode == ViewMode.Day ? "44px" : "52px";

    // ── Period helpers ─────────────────────────────────────────────────────────

    List<DateOnly> Periods => Mode switch
    {
        ViewMode.Week  => BuildWeeks(),
        ViewMode.Month => BuildMonths(),
        _              => BuildDays(),
    };

    List<DateOnly> BuildDays() => Enumerable
        .Range(0, ViewEnd.DayNumber - ViewStart.DayNumber + 1)
        .Select(i => ViewStart.AddDays(i))
        .ToList();

    List<DateOnly> BuildWeeks()
    {
        var dow   = (int)ViewStart.DayOfWeek;
        var first = ViewStart.AddDays(-(dow == 0 ? 6 : dow - 1)); // align to Monday
        var weeks = new List<DateOnly>();
        for (var d = first; d <= ViewEnd; d = d.AddDays(7))
            weeks.Add(d);
        return weeks;
    }

    List<DateOnly> BuildMonths()
    {
        var months = new List<DateOnly>();
        var d = new DateOnly(ViewStart.Year, ViewStart.Month, 1);
        while (d <= ViewEnd) { months.Add(d); d = d.AddMonths(1); }
        return months;
    }

    DateOnly PeriodEnd(DateOnly p) => Mode switch
    {
        ViewMode.Week  => p.AddDays(6),
        ViewMode.Month => new DateOnly(p.Year, p.Month, DateTime.DaysInMonth(p.Year, p.Month)),
        _              => p,
    };

    bool IsCurrentPeriod(DateOnly p) => Mode switch
    {
        ViewMode.Week  => Today >= p && Today <= p.AddDays(6),
        ViewMode.Month => Today.Year == p.Year && Today.Month == p.Month,
        _              => p == Today,
    };

    // ── Grid helpers ───────────────────────────────────────────────────────────

    string GridColumns => $"90px {string.Join(" ", AllAssets.Select(_ => "1fr"))}";

    /// <summary>1-indexed grid row where this date first appears (start of its period).</summary>
    int SpanStartRow(DateOnly date, List<DateOnly> periods)
    {
        for (int i = 0; i < periods.Count; i++)
            if (PeriodEnd(periods[i]) >= date)
                return i + 1;
        return periods.Count + 1;
    }

    /// <summary>1-indexed exclusive end row (period after the last period containing this date).</summary>
    int SpanEndRow(DateOnly date, List<DateOnly> periods)
    {
        for (int i = periods.Count - 1; i >= 0; i--)
            if (periods[i] <= date)
                return i + 2;
        return 1;
    }

    // ── Day-view cell map ──────────────────────────────────────────────────────

    Dictionary<(int, DateOnly), CellInfo> CellMap = new();

    enum CellPos { Single, Top, Mid, Bottom }
    record CellInfo(CellPos Pos, string Color, string Label);

    void BuildCellMap()
    {
        CellMap.Clear();
        foreach (var asset in AllAssets)
        {
            foreach (var u in asset.UnavailabilityPeriods)
            {
                for (var d = u.StartDate; d <= u.EndDate; d = d.AddDays(1))
                {
                    if (d < ViewStart || d > ViewEnd) continue;
                    CellMap[(asset.Id, d)] = new CellInfo(
                        DayPos(u.StartDate, u.EndDate.AddDays(1), d), "#d1d5db", "Unavailable");
                }
            }

            foreach (var b in AllBookings.Where(b => b.AssetId == asset.Id))
            {
                var lastNight = b.EndDate.AddDays(-1);
                for (var d = b.StartDate; d <= lastNight; d = d.AddDays(1))
                {
                    if (d < ViewStart || d > ViewEnd) continue;
                    var label = b.IsFullBooking
                        ? b.User.FullName
                        : $"{b.User.FullName} ({b.BedsBooked} bed{(b.BedsBooked == 1 ? "" : "s")})";
                    CellMap[(asset.Id, d)] = new CellInfo(DayPos(b.StartDate, b.EndDate, d), b.Asset.Color, label);
                }
            }
        }
    }

    static CellPos DayPos(DateOnly start, DateOnly exclusiveEnd, DateOnly day)
    {
        var last = exclusiveEnd.AddDays(-1);
        return (day == start, day == last) switch
        {
            (true,  true)  => CellPos.Single,
            (true,  false) => CellPos.Top,
            (false, true)  => CellPos.Bottom,
            _              => CellPos.Mid,
        };
    }

    CellInfo? GetCell(int assetId, DateOnly day)
        => CellMap.TryGetValue((assetId, day), out var c) ? c : null;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        SetViewRange();
        AllAssets = await AssetService.GetAllAsync();
        foreach (var a in AllAssets)
        {
            var full = await AssetService.GetByIdAsync(a.Id);
            if (full != null) a.UnavailabilityPeriods = full.UnavailabilityPeriods;
        }
        await RefreshBookings();
        IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            DotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vtl.setup", DotNetRef);
            await JS.InvokeVoidAsync("vtl.scrollToToday");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("vtl.dispose"); } catch { }
        DotNetRef?.Dispose();
    }

    async Task RefreshBookings()
    {
        AllBookings = await BookingService.GetForRangeAsync(ViewStart, ViewEnd);
        BuildCellMap();
    }

    void SetViewRange()
    {
        (int back, int forward) = Mode switch
        {
            ViewMode.Week  => (14,  7 * 52),
            ViewMode.Month => (30,  365 * 2),
            _              => (7,   90),
        };
        ViewStart = Today.AddDays(-back);
        ViewEnd   = Today.AddDays(forward);
    }

    async Task SwitchMode(ViewMode mode)
    {
        Mode = mode;
        SetViewRange();
        await RefreshBookings();
        await JS.InvokeVoidAsync("vtl.scrollToToday");
    }

    [JSInvokable]
    public async Task LoadMore()
    {
        if (IsLoadingMore) return;
        IsLoadingMore = true;
        StateHasChanged();

        ViewEnd = ViewEnd.AddDays(Mode switch
        {
            ViewMode.Week  => 7 * 13,
            ViewMode.Month => 180,
            _              => 60,
        });
        await RefreshBookings();

        IsLoadingMore = false;
        StateHasChanged();
    }

    async Task JumpToToday() =>
        await JS.InvokeVoidAsync("vtl.scrollToToday");
}
