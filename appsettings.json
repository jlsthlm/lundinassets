{
  // Secrets are supplied at deploy time, not committed here. docker-compose.yml
  // reads them from .env; a systemd deploy sets them in the unit file. See
  // .env.example and deploy/lundinassets.service.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AdminUser": {
    "Email": "admin@lundinassets.se",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
